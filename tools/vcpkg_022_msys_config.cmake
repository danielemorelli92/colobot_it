# Loaded by the three GNU ports through their local host-tool dependency.
# Leave vcpkg's registry and its acquisition functions on disk unchanged.
set(ENV{WANT_AUTOCONF} "2.71")
set(ENV{WANT_AUTOMAKE} "1.16")
function(vcpkg_acquire_msys out_msys_root)
    if(NOT DEFINED ENV{COLOBOT022_MSYS_ROOT})
        message(FATAL_ERROR "The verified local MSYS2 root was not passed to vcpkg")
    endif()
    cmake_parse_arguments(PARSE_ARGV 1 local_msys
        "NO_DEFAULT_PACKAGES;Z_ALL_PACKAGES" "" "PACKAGES;DIRECT_PACKAGES")
    if(local_msys_DIRECT_PACKAGES OR local_msys_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "The local MSYS2 adapter does not supply direct package archives")
    endif()
    file(TO_CMAKE_PATH "$ENV{COLOBOT022_MSYS_ROOT}" local_msys_root)
    foreach(tool bash make gzip)
        if(NOT EXISTS "${local_msys_root}/usr/bin/${tool}.exe")
            message(FATAL_ERROR "Missing verified MSYS2 tool: ${tool}")
        endif()
    endforeach()
    if(NOT EXISTS "${local_msys_root}/usr/share/automake-1.16/compile")
        message(FATAL_ERROR "The MSVC compiler wrapper from automake1.16 is missing")
    endif()
    set("${out_msys_root}" "${local_msys_root}" PARENT_SCOPE)
    message(STATUS "Using verified local MSYS2 tools at ${local_msys_root}")
endfunction()
