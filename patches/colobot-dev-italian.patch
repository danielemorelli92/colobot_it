+TEST_F(CApplicationUT, ItalianLanguageRoundTrip)
+{
+    Language language = LANGUAGE_ENV;
+    ASSERT_TRUE(ParseLanguage("it", language));
+    EXPECT_EQ(LANGUAGE_ITALIAN, language);
+
+    m_app->SetLanguage(language);
+    EXPECT_EQ(LANGUAGE_ITALIAN, m_app->GetLanguage());
+    EXPECT_EQ('I', m_app->GetLanguageChar());
+    EXPECT_EQ("I", m_app->GetLanguageDir().string());
+
+    std::string code;
+    ASSERT_TRUE(LanguageToString(language, code));
+    EXPECT_EQ("it", code);
+}
+
+TEST_F(CApplicationUT, ExistingLanguageIdentifiersStayCompatible)
+{
+    EXPECT_EQ(7, LANGUAGE_MAGYAR);
+    EXPECT_NE(LANGUAGE_MAGYAR, LANGUAGE_ITALIAN);
+
+    const std::pair<const char*, char> languages[] = {
+        {"en", 'E'}, {"fr", 'F'}, {"de", 'D'}, {"pl", 'P'},
+        {"ru", 'R'}, {"cs", 'C'}, {"pt", 'B'}, {"hu", 'H'}
+    };
+    for (const auto& [code, character] : languages)
+    {
+        SCOPED_TRACE(code);
+        Language language = LANGUAGE_ENV;
+        ASSERT_TRUE(ParseLanguage(code, language));
+        m_app->SetLanguage(language);
+        EXPECT_EQ(character, m_app->GetLanguageChar());
+        EXPECT_NE('I', m_app->GetLanguageChar());
+    }
+}
