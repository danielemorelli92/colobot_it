"\\tab;Minerale di uranio:      presente"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> SOTTOSUOLO<c/>"

#. type: Plain text
