#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Time for a sharp exit"
msgstr "È ora di fuggire"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Try to leave the planet alive."
msgstr "Cerca di lasciare il pianeta vivo."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Dal centro di controllo missione"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "You need to repel a last minute ant attack before taking off."
msgstr "Prima di decollare devi respingere un ultimo attacco delle formiche."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid ""
"<format key><key help/></format> allows you to review these instructions at "
"all times on your personal SatCom <button 63/>."
msgstr ""
"<format key><key help/></format> ti permette di rileggere queste istruzioni "
"in qualsiasi momento sul tuo SatCom personale <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:6
#, no-wrap
msgid "See also"
msgstr "Vedi anche"

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Comandi</a> e <a cbot>linguaggio CBOT</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Rapporto satellitare"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Volcano."
msgstr "Attualmente in orbita geostazionaria attorno a Volcano."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> SUPERFICIE<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      96.6C\n"
"\\tab;Atmosphere:       CO2, SO2, HCN, HS, CH4, NH3\n"
"\\tab;Wind:             2.7 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Temperatura:      96.6C\n"
"\\tab;Atmosfera:       CO2, SO2, HCN, HS, CH4, NH3\n"
"\\tab;Vento:             2.7 mps\n"
"\\tab;Minerale di titanio:     assente\n"
"\\tab;Minerale di uranio:      assente"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> SOTTOSUOLO<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Fonte di energia:    assente\n"
"\\tab;Minerale di titanio:     assente\n"
"\\tab;Minerale di uranio:      assente"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> INFORMAZIONI AGGIUNTIVE<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       immediate"
msgstr ""
"\\tab;Rilevato:         formiche giganti\n"
"\\tab;  - Pericolo:       immediato"
