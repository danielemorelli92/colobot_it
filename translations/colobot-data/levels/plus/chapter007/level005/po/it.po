#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Self-defense"
msgstr "Autodifesa"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Combine defensive and offensive weapons to deal with a massive attack."
msgstr ""
"Combina armi difensive e offensive per affrontare un attacco massiccio."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Dal centro di controllo missione"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid "You're under attack and this is no time for compassion..."
msgstr "Sei sotto attacco: non è il momento della compassione..."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid ""
"Your new <a object|bottump>thumper</a> might come in very handy. However, we"
" emphasize that you should not risk a takeoff if there are any ants still "
"alive in the vicinity of the spaceship."
msgstr ""
"Il nuovo <a object|bottump>robot percussore</a> potrebbe esserti molto "
"utile. Ti raccomandiamo però di non tentare il decollo finché ci sono "
"formiche vive nelle vicinanze dell’astronave."

#. type: Plain text
#: ../help/help.E.txt:6
#, no-wrap
msgid ""
"<format key><key help/></format> allows you to review these instructions at "
"all times on your personal SatCom <button 63/>."
msgstr ""
"<format key><key help/></format> ti permette di rileggere queste istruzioni "
"in qualsiasi momento sul tuo SatCom personale <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:8
#, no-wrap
msgid "See also"
msgstr "Vedi anche"

#. type: Plain text
#: ../help/help.E.txt:9
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Comandi</a> e <a cbot>linguaggio CBOT</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Rapporto satellitare"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Centaury."
msgstr "Attualmente in orbita geostazionaria attorno a Centaury."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> SUPERFICIE<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      21.3C\n"
"\\tab;Atmosphere:       oxygen, nitrogen, ammonia\n"
"\\tab;Wind:             1.9 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Temperatura:      21.3C\n"
"\\tab;Atmosfera:       ossigeno, azoto, ammoniaca\n"
"\\tab;Vento:             1.9 mps\n"
"\\tab;Minerale di titanio:     assente\n"
"\\tab;Minerale di uranio:      assente"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> SOTTOSUOLO<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Fonte di energia:    assente\n"
"\\tab;Minerale di titanio:     assente\n"
"\\tab;Minerale di uranio:      assente"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> INFORMAZIONI AGGIUNTIVE<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       immediate"
msgstr ""
"\\tab;Rilevato:         formiche giganti\n"
"\\tab;  - Pericolo:       immediato"
