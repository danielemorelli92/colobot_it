#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Uranium"
msgstr "Uranio"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "An attempt to retrieve some uranium ore."
msgstr "Tenta di recuperare del minerale di uranio."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Dal centro di controllo missione"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid ""
"The observation satellite has detected a chunk of <a object|uranore>uranium "
"ore</a> on the summit of the main mountain. You need to bring it back to "
"your spaceship."
msgstr ""
"Il satellite ha rilevato un pezzo di <a object|uranore>minerale di "
"uranio</a> sulla vetta della montagna principale. Devi riportarlo alla tua "
"astronave."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid ""
"<format key><key help/></format> allows you to review these instructions at "
"all times on your personal SatCom <button 63/>."
msgstr ""
"<format key><key help/></format> ti permette di rileggere queste istruzioni "
"in qualsiasi momento sul tuo SatCom personale <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:6
#, no-wrap
msgid "See also"
msgstr "Vedi anche"

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Comandi</a> e <a cbot>linguaggio CBOT</a>"

#. type: \b; header
#: ../help/report.E.txt:1
#, no-wrap
msgid "Satellite Report"
msgstr "Rapporto satellitare"

#. type: Plain text
#: ../help/report.E.txt:2
#, no-wrap
msgid "Currently in a geo-stationary orbit of Saari."
msgstr "Attualmente in orbita geostazionaria attorno a Saari."

#. type: Source code
#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> SUPERFICIE<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      41.3C\n"
"\\tab;Atmosphere:       CO2, oxygen, nitrogen\n"
"\\tab;Wind:             2.3 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      some (mountain summit)"
msgstr ""
"\\tab;Temperatura:      41.3C\n"
"\\tab;Atmosfera:       CO2, ossigeno, azoto\n"
"\\tab;Vento:             2.3 mps\n"
"\\tab;Minerale di titanio:     assente\n"
"\\tab;Minerale di uranio:      presente (vetta della montagna)"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> SOTTOSUOLO<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    everywhere\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Fonte di energia:    ovunque\n"
"\\tab;Minerale di titanio:     assente\n"
"\\tab;Minerale di uranio:      assente"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> INFORMAZIONI AGGIUNTIVE<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         reusable derelicts \n"
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       not immediate"
msgstr ""
"\\tab;Rilevato:         relitti riutilizzabili \n"
"\\tab;Rilevato:         formiche giganti\n"
"\\tab;  - Pericolo:       non immediato"
