#: ../help/report.E.txt:4
#, no-wrap
msgid "-> SURFACE<c/>"
msgstr "-> SUPERFICIE<c/>"

#. type: Plain text
#: ../help/report.E.txt:5
#, no-wrap
msgid ""
"\\tab;Temperature:      -64.7C\n"
"\\tab;Atmosphere:       none\n"
"\\tab;Wind:             0.0 mps\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Temperatura:      -64.7C\n"
"\\tab;Atmosfera:       assente\n"
"\\tab;Vento:             0.0 mps\n"
"\\tab;Minerale di titanio:     assente\n"
"\\tab;Minerale di uranio:      assente"

#. type: Source code
#: ../help/report.E.txt:11
#, no-wrap
msgid "-> SUBSOIL<c/>"
msgstr "-> SOTTOSUOLO<c/>"

#. type: Plain text
#: ../help/report.E.txt:12
#, no-wrap
msgid ""
"\\tab;Energy source:    none\n"
"\\tab;Titanium ore:     none\n"
"\\tab;Uranium ore:      none"
msgstr ""
"\\tab;Fonte di energia:    assente\n"
"\\tab;Minerale di titanio:     assente\n"
"\\tab;Minerale di uranio:      assente"

#. type: Source code
#: ../help/report.E.txt:16
#, no-wrap
msgid "-> ADDITIONAL INFORMATION<c/>"
msgstr "-> INFORMAZIONI AGGIUNTIVE<c/>"

#. type: Plain text
#: ../help/report.E.txt:17
#, no-wrap
msgid ""
"\\tab;Detected:         giant ants\n"
"\\tab;  - Danger:       not immediate\n"
"\\tab;Detected:         fierce electromagnetic storms"
msgstr ""
"\\tab;Rilevato:         formiche giganti\n"
"\\tab;  - Pericolo:       non immediato\n"
"\\tab;Rilevato:         violente tempeste elettromagnetiche"

#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Soluzione"

#. type: Plain text
#: ../help/soluce.E.txt:2
#, no-wrap
msgid ""
"You will find a <a object|radar>radar</a>, a <a object|captor>power "
"captor</a>, a <a object|power>power cell</a> and a <a object|botoj>winged "
"orga shooter</a> in the valley south of the spaceship. This will allow you "
"to kill the ants close to the spaceship and to locate the <a "
"object|bbox>black box</a> in the north next to the remains of the first "
"expedition spaceship."
msgstr ""
"Nella valle a sud dell’astronave troverai un <a object|radar>radar</a>, un "
"<a object|captor>parafulmine</a>, una <a object|power>batteria</a> e un <a "
"object|botoj>robot tiratore organico volante</a>. Potrai eliminare le "
"formiche vicine all’astronave e individuare la <a object|bbox>scatola "
"nera</a> a nord, accanto ai resti dell’astronave della prima spedizione."

#. type: Plain text
#: ../help/soluce.E.txt:4
#, no-wrap
msgid ""
"Build a succession of <a object|captor>power captors</a> along the natural "
"path offered by the northern mountain peaks. 5 or 6 captors should offer "
"sufficient protection against lightning."
msgstr ""
"Costruisci una serie di <a object|captor>parafulmini</a> lungo il percorso "
"naturale offerto dalle cime montuose a nord. Ne dovrebbero bastare 5 o 6 per"
" proteggerti dai fulmini."

#. type: Plain text
#: ../help/soluce.E.txt:6
#, no-wrap
msgid ""
"Bring the black box back aboard your <a object|base>spaceship</a> and take "
"off."
msgstr "Riporta la scatola nera sull’<a object|base>astronave</a> e decolla."

#. type: Plain text
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Comandi</a>"
