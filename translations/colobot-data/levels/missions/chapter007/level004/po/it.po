#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Soluzione"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Search the area for <a object|titan>titanium</a>."
msgstr "Cerca <a object|titan>titanio</a> nella zona."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:3
#, no-wrap
msgid "Build a <a object|convert>converter</a>."
msgstr "Costruisci un <a object|convert>convertitore</a>."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Build a <a object|research>research center</a>."
msgstr "Costruisci un <a object|research>centro di ricerca</a>."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Run the <thumper research program> <button 66/>."
msgstr "Avvia la <ricerca sul robot percussore> <button 66/>."

#. type: Bullet: '5)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Manufacture a <a object|bottump>thumper</a>."
msgstr "Produci un <a object|bottump>robot percussore</a>."

#. type: Bullet: '6)'
#: ../help/soluce.E.txt:7
#, no-wrap
msgid ""
"Position the thumper close to the derelict spaceship and \"thump\" the "
"ground."
msgstr ""
"Posiziona il robot percussore vicino al relitto dell’astronave e percuoti il"
" terreno."

#. type: Bullet: '7)'
#: ../help/soluce.E.txt:8
#, no-wrap
msgid ""
"Quickly retrieve the <a object|bbox>black box</a> and bring it back aboard "
"your <a object|base>spaceship</a>."
msgstr ""
"Recupera rapidamente la <a object|bbox>scatola nera</a> e portala a bordo "
"dell’<a object|base>astronave</a>."

#. type: Bullet: '8)'
#: ../help/soluce.E.txt:9
#, no-wrap
msgid "Bring the thumper along and take off."
msgstr "Porta con te il robot percussore e decolla."

#. type: Plain text
#: ../help/soluce.E.txt:12
#, no-wrap
msgid "<a command>Controls</a>"
msgstr "<a command>Comandi</a>"
