#. type: \b; header
#: ../help/soluce.E.txt:1
#, no-wrap
msgid "Walkthrough"
msgstr "Soluzione"

#. type: Bullet: '1)'
#: ../help/soluce.E.txt:2
#, no-wrap
msgid "Build a <a object|factory>bot factory</a>."
msgstr "Costruisci una <a object|factory>fabbrica di robot</a>."

#. type: Bullet: '2)'
#: ../help/soluce.E.txt:3
#, no-wrap
msgid "Produce a <a object|botgj>winged grabber</a>."
msgstr "Produci un <a object|botgj>robot trasportatore volante</a>."

#. type: Bullet: '3)'
#: ../help/soluce.E.txt:4
#, no-wrap
msgid "Carry a <a object|titan>titanium cube</a> to the highest point."
msgstr "Porta un <a object|titan>cubo di titanio</a> nel punto più alto."

#. type: Bullet: '4)'
#: ../help/soluce.E.txt:5
#, no-wrap
msgid "Build a <a object|radar>radar</a> on the spot."
msgstr "Costruisci lì un <a object|radar>radar</a>."

#. type: Bullet: '5)'
#: ../help/soluce.E.txt:6
#, no-wrap
msgid "Build a <a object|research>research center</a> next to the spaceship."
msgstr ""
"Costruisci un <a object|research>centro di ricerca</a> accanto "
"all’astronave."

#. type: Bullet: '6)'
#: ../help/soluce.E.txt:7
#, no-wrap
msgid "Initiate the <defense tower research program> <button 68/>."
msgstr "Avvia la <ricerca sulla torre difensiva> <button 68/>."

#. type: Bullet: '7)'
#: ../help/soluce.E.txt:8
#, no-wrap
msgid "Build the <a object|tower>defense tower</a> next to the radar."
msgstr "Costruisci la <a object|tower>torre difensiva</a> accanto al radar."

#. type: Bullet: '8)'
#: ../help/soluce.E.txt:9
#, no-wrap
msgid ""
"When all the worms are destroyed, you can go back to your ship and take off."
msgstr ""
"Quando tutti i vermi sono stati eliminati, torna all’astronave e decolla."

