#. type: Title-text
#: ../scene.txt:1
#, no-wrap
msgid "Flying Drill #2"
msgstr "Esercitazione di volo n. 2"

#. type: Resume-text
#: ../scene.txt:2
#, no-wrap
msgid "Sharpen your flying skills (cont'd)."
msgstr "Affina ancora le tue abilità di volo."

#. type: \b; header
#: ../help/help.E.txt:1
#, no-wrap
msgid "From Mission Control"
msgstr "Dal centro di controllo missione"

#. type: Plain text
#: ../help/help.E.txt:2
#, no-wrap
msgid ""
"Similar drill as before, only this time viewed through the camera placed on "
"board."
msgstr ""
"Un’esercitazione simile alla precedente, ma questa volta con la visuale "
"della telecamera a bordo."

#. type: Plain text
#: ../help/help.E.txt:4
#, no-wrap
msgid ""
"<format key><key help/></format> allows you to review these instructions at "
"all times on your personal SatCom <button 63/>."
msgstr ""
"<format key><key help/></format> ti permette di rileggere queste istruzioni "
"in qualsiasi momento sul tuo SatCom personale <button 63/>."

#. type: \t; header
#: ../help/help.E.txt:6 ../help/soluce.E.txt:6
#, no-wrap
msgid "See also"
msgstr "Vedi anche"

#. type: Plain text
#: ../help/help.E.txt:7
#, no-wrap
msgid "<a command>Controls</a> and <a cbot>CBOT Language</a>"
msgstr "<a command>Comandi</a> e <a cbot>linguaggio CBOT</a>"

