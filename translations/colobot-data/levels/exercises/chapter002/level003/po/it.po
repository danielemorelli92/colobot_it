#: ../help/help.E.txt:40
#, no-wrap
msgid ""
"<a cbot>Programming</a>, <a cbot|type>types</a> and <a "
"cbot|category>categories</a>."
msgstr ""
"<a cbot>Programmazione</a>, <a cbot|type>tipi</a> e <a "
"cbot|category>categorie</a>."

#. type: Plain text
#: ../help/help.E.txt:37
#, no-wrap
msgid ""
"Just insert these lines before the instruction <c/>fire(1);<n/>, and the bot"
" will wait before shooting until the ant is closer than 40 meters. Like this"
" a regular power cell is enough to kill all ants. "
msgstr ""
"Inserisci queste righe prima di <c/>fire(1);<n/>: il robot aspetterà la "
"formica entro 40 m. Basterà così una batteria normale per eliminarle tutte. "
