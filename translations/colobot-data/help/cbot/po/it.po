"<code>-=</code>  subtraction\n"
"<code>*=</code>  multiplication\n"
"<code>/=</code>  division\n"
"<code>%=</code>  remainder of the division"
msgstr ""
"<code>+=</code>  addizione\n"
"<code>-=</code>  sottrazione\n"
"<code>*=</code>  moltiplicazione\n"
"<code>/=</code>  divisione\n"
"<code>%=</code>  resto della divisione"

