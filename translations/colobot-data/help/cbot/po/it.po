#. type: Plain text
#: ../E/expr.txt:54
#, no-wrap
msgid ""
"<code>+</code>  addition\n"
"<code>-</code>  subtraction\n"
"<code>*</code>  multiplication\n"
"<code>/</code>  division\n"
"<code>%</code>  remainder of the division (works for <code><a cbot|int>int</a></code> as well as <code><a cbot|float>float</a></code>)"
msgstr ""
"<code>+</code>  addizione\n"
"<code>-</code>  sottrazione\n"
"<code>*</code>  moltiplicazione\n"
"<code>/</code>  divisione\n"
"<code>%</code>  resto della divisione (per <code><a cbot|int>int</a></code> e <code><a cbot|float>float</a></code>)"

#. type: Source code
#: ../E/expr.txt:66
#, no-wrap
msgid ""
" int    i = 12 + 3;      // i == 15\n"
" int    i = 2 - 5;       // i == -3\n"
" \n"
" float  f = 3.01 * 10;   // f == 30.1\n"
" \n"
" int    i = 5 / 3;       // i == 1 (automatic conversion to int)\n"
" float  f = 5 / 3;       // f == 1.67\n"
" float  f = 5 / 0;       // returns an error (division by zero)\n"
" \n"
" int    i = 13 % 5;      // i == 3\n"
" int    i = -8 % 3;      // i == -2\n"
" float  f = -4.5 % 2.75; // f == -1.75\n"
" \n"
" float  f = sin(90) * i; // f == -2.0\n"
" "
msgstr ""
" int    i = 12 + 3;      // i == 15\n"
" int    i = 2 - 5;       // i == -3\n"
" \n"
" float  f = 3.01 * 10;   // f == 30.1\n"
" \n"
" int    i = 5 / 3;       // i == 1 (automatic conversion to int)\n"
" float  f = 5 / 3;       // f == 1.67\n"
" float  f = 5 / 0;       // returns an error (division by zero)\n"
" \n"
" int    i = 13 % 5;      // i == 3\n"
" int    i = -8 % 3;      // i == -2\n"
" float  f = -4.5 % 2.75; // f == -1.75\n"
" \n"
" float  f = sin(90) * i; // f == -2.0\n"
" "

#. type: Plain text
#: ../E/expr.txt:91
#, no-wrap
msgid ""
