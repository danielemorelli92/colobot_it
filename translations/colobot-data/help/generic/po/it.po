#. type: \b; header
#: ../E/cbot.txt:1
#, no-wrap
msgid "Programming - the CBOT language"
msgstr "Programmazione: il linguaggio CBOT"

#. type: Plain text
#: ../E/cbot.txt:2
#, no-wrap
msgid ""
"The CBOT language is very close in structure and syntax to C++ and Java. It has been adapted for the specific purposes of COLOBOT, and for an efficient pedagogical approach.\n"
"This language is made up of instructions (see below), <a cbot|bloc>blocks</a>, <a cbot|function>functions</a>, <a cbot|class>classes</a>, <a cbot|var>variables</a>, <a cbot|array>arrays</a>, <a cbot|expr>expressions</a> and <a cbot|cond>conditions</a>."
msgstr ""
"Il linguaggio CBOT ha struttura e sintassi molto simili a C++ e Java. È stato adattato alle esigenze di COLOBOT e a un approccio didattico efficace.\n"
"Il linguaggio comprende istruzioni (vedi sotto), <a cbot|bloc>blocchi</a>, <a cbot|function>funzioni</a>, <a cbot|class>classi</a>, <a cbot|var>variabili</a>, <a cbot|array>array</a>, <a cbot|expr>espressioni</a> e <a cbot|cond>condizioni</a>."

#. type: Bullet: 'o'
#: ../E/cbot.txt:8
#, no-wrap
msgid "<code><format type>Type</format></code>"
msgstr "<code><format type>Tipi</format></code>"

#. type: Bullet: 'o'
#: ../E/cbot.txt:11
#, no-wrap
msgid "<code><format const>Constants</format></code>"
msgstr "<code><format const>Costanti</format></code>"

#. type: \t; header
#: ../E/cbot.txt:14
#, no-wrap
msgid "Instructions in the CBOT language:"
msgstr "Istruzioni del linguaggio CBOT:"

#. type: \t; header
#: ../E/cbot.txt:29
#, no-wrap
msgid "Specific instructions for bots:"
msgstr "Istruzioni specifiche per i robot:"

#. type: \t; header
#: ../E/cbot.txt:61
#, no-wrap
msgid "Instructions about topology:"
msgstr "Istruzioni relative alla topografia:"

#. type: \t; header
#: ../E/cbot.txt:67
#, no-wrap
msgid "Instructions specific to some bots:"
msgstr "Istruzioni specifiche per alcuni robot:"

#. type: \t; header
#: ../E/cbot.txt:80
#, no-wrap
msgid "Specific instructions for exchange posts:"
msgstr "Istruzioni specifiche per i centri di scambio dati:"

#. type: Plain text
#: ../E/cbot.txt:81
#, no-wrap
msgid ""
"<code><a cbot|receive>receive</a>    </code>Receives an information\n"
"<code><a cbot|send>send</a>       </code>Sends a new information\n"
"<code><a cbot|testinfo>testinfo</a>   </code>Tests if an information exists\n"
"<code><a cbot|delinfo>deleteinfo</a> </code>Deletes an existing information"
msgstr ""
"<code><a cbot|receive>receive</a>    </code>Riceve un dato\n"
"<code><a cbot|send>send</a>       </code>Invia un nuovo dato\n"
"<code><a cbot|testinfo>testinfo</a>   </code>Verifica se un dato esiste\n"
"<code><a cbot|delinfo>deleteinfo</a> </code>Elimina un dato esistente"

#. type: \t; header
#: ../E/cbot.txt:86
#, no-wrap
msgid "Specific instructions for classes:"
msgstr "Istruzioni specifiche per le classi:"

#. type: \t; header
#: ../E/cbot.txt:98
#, no-wrap
msgid "Specific instructions for strings:"
msgstr "Istruzioni specifiche per le stringhe:"

#. type: Plain text
#: ../E/cbot.txt:99
#, no-wrap
msgid ""
"<code><a cbot|strlen>strlen</a>     </code>Gets string length\n"
"<code><a cbot|strleft>strleft</a>    </code>Extracts left part\n"
"<code><a cbot|strright>strright</a>   </code>Extracts right part\n"
"<code><a cbot|strmid>strmid</a>     </code>Extracts center part\n"
"<code><a cbot|strfind>strfind</a>    </code>Finds a substring.\n"
"<code><a cbot|strval>strval</a>     </code>Converts string to number\n"
"<code><a cbot|strupper>strupper</a>   </code>Converts to upper case\n"
"<code><a cbot|strlower>strlower</a>   </code>Converts to lower case"
msgstr ""
"<code><a cbot|strlen>strlen</a>     </code>Restituisce la lunghezza della stringa\n"
"<code><a cbot|strleft>strleft</a>    </code>Estrae la parte sinistra\n"
"<code><a cbot|strright>strright</a>   </code>Estrae la parte destra\n"
"<code><a cbot|strmid>strmid</a>     </code>Estrae la parte centrale\n"
"<code><a cbot|strfind>strfind</a>    </code>Trova una sottostringa.\n"
"<code><a cbot|strval>strval</a>     </code>Converte una stringa in numero\n"
"<code><a cbot|strupper>strupper</a>   </code>Converte in maiuscolo\n"
"<code><a cbot|strlower>strlower</a>   </code>Converte in minuscolo"

#. type: \t; header
#: ../E/cbot.txt:108
#, no-wrap
msgid "Specific instructions for files:"
msgstr "Istruzioni specifiche per i file:"

#. type: Plain text
#: ../E/cbot.txt:109
#, no-wrap
msgid ""
"<code><a cbot|open>open</a>       </code>Opens a file\n"
"<code><a cbot|close>close</a>      </code>Closes a file\n"
"<code><a cbot|writeln>writeln</a>    </code>Writes line to a file\n"
"<code><a cbot|readln>readln</a>     </code>Reads line from a file\n"
"<code><a cbot|eof>eof</a>        </code>Tests if end of file\n"
"<code><a cbot|deletef>deletefile</a> </code>Deletes a file"
msgstr ""
"<code><a cbot|open>open</a>       </code>Apre un file\n"
"<code><a cbot|close>close</a>      </code>Chiude un file\n"
"<code><a cbot|writeln>writeln</a>    </code>Scrive una riga in un file\n"
"<code><a cbot|readln>readln</a>     </code>Legge una riga da un file\n"
"<code><a cbot|eof>eof</a>        </code>Verifica la fine del file\n"
"<code><a cbot|deletef>deletefile</a> </code>Elimina un file"

