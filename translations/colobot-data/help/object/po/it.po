msgid "<button 162/> Converter"
msgstr "<button 162/> Convertitore"

#. type: Image filename
#: ../E/convert.txt:2
#, no-wrap
msgid "convert"
msgstr "convert"

#. type: Plain text
#: ../E/convert.txt:3
#, no-wrap
msgid ""
"This building was designed to convert chunks of <a object|titanore>titanium "
"ore</a> into usable <a object|titan>titanium cubes</a>. All <a "
"object|human>you</a> need to do is place a chunk at the center of the "
"platform and step back. The converter takes care of the rest."
msgstr ""
"Questo edificio converte il <a object|titanore>minerale di titanio</a> in <a"
" object|titan>cubi di titanio</a> utilizzabili. <a object|human>Devi</a> "
"soltanto posare un pezzo di minerale al centro della piattaforma e "
"allontanarti. Il convertitore farà il resto."

#. type: Plain text
#: ../E/convert.txt:6 ../E/labo.txt:6 ../E/repair.txt:6
#, no-wrap
msgid "Any flat surface of at least 6 meters wide."
msgstr "Qualsiasi superficie pianeggiante larga almeno 6 metri."

